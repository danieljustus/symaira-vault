      "args": ["--help"],
      "timeout_ms": 10000,
      "stdout_mode": "console_text",
      "stderr_mode": "console_text",
      "compare_files": true
    },
    {
      "id": "hidden-serve-help",
      "stage": "full-cli",
      "args": ["serve", "--help"],
      "timeout_ms": 10000,
      "stdout_mode": "console_text",
      "stderr_mode": "console_text",
      "compare_files": true
    },
    {
