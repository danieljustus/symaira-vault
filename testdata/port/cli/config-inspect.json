  "cases": [
    {
      "name": "get_scalar_text",
      "description": "read a scalar in text mode",
      "config": "vaultDir: /fixture/vault\n",
      "args": [
        "config",
        "get",
        "vaultDir",
        "--file",
        "__CONFIG__"
      ],
      "expected": {
        "exit_code": 0,
        "stdout": "/fixture/vault\n"
      }
    },
    {
      "name": "get_nested_bool",
      "description": "read a nested boolean in text mode",
      "config": "agents:\n  probe:\n    canWrite: true\n",
      "args": [
        "config",
        "get",
        "agents.probe.canWrite",
        "--file",
        "__CONFIG__"
      ],
      "expected": {
        "exit_code": 0,
        "stdout": "true\n"
      }
    },
    {
      "name": "get_complex_sequence",
      "description": "render a sequence using YAML block text",
      "config": "allowed:\n  - /fixture/a\n  - /fixture/b\n",
      "args": [
        "config",
        "get",
        "allowed",
        "--file",
        "__CONFIG__"
      ],
      "expected": {
        "exit_code": 0,
        "stdout": "- /fixture/a\n- /fixture/b\n"
      }
    },
    {
      "name": "get_scalar_json",
      "description": "encode a scalar result as a JSON object",
      "config": "vaultDir: /fixture/vault\n",
      "args": [
        "config",
        "get",
        "vaultDir",
        "--file",
        "__CONFIG__",
        "--output",
        "json"
      ],
      "expected": {
        "exit_code": 0,
        "stdout": "{\"vaultDir\":\"/fixture/vault\"}\n"
      }
