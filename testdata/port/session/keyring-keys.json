    },
    {
      "name": "unicode_service",
      "description": "non-ASCII survives the split unchanged",
      "key": "symvault:/home/ü/vält|session",
      "service": "symvault:/home/ü/vält",
      "account": "session",
      "natively_addressable": true
    },
    {
      "name": "windows_path_service",
      "description": "a Windows vault path is just a service string",
      "key": "symvault:C:\\Users\\u\\.symvault|session",
      "service": "symvault:C:\\Users\\u\\.symvault",
      "account": "session",
      "natively_addressable": true
    }
  ],
  "backend_cases": [
    {
      "name": "round_trip",
      "description": "set, read back, delete, and the entry is gone",
      "steps": [
        {
          "op": "get",
          "key": "symvault:/v|wrap-key",
          "outcome": "not_found"
        },
        {
          "op": "set",
          "key": "symvault:/v|wrap-key",
          "value": "first",
          "outcome": "ok"
        },
        {
          "op": "get",
          "key": "symvault:/v|wrap-key",
          "outcome": "found",
          "got": "first"
        },
        {
          "op": "delete",
          "key": "symvault:/v|wrap-key",
          "outcome": "ok"
        },
        {
          "op": "get",
          "key": "symvault:/v|wrap-key",
          "outcome": "not_found"
        }
      ]
    },
    {
      "name": "set_replaces",
      "description": "a second set replaces rather than appends",
      "steps": [
        {
          "op": "set",
          "key": "symvault:/v|wrap-key",
          "value": "first",
          "outcome": "ok"
        },
        {
          "op": "set",
          "key": "symvault:/v|wrap-key",
          "value": "second",
          "outcome": "ok"
        },
        {
          "op": "get",
          "key": "symvault:/v|wrap-key",
          "outcome": "found",
          "got": "second"
        }
      ]
    },
    {
      "name": "delete_is_idempotent",
      "description": "deleting an absent entry succeeds, and deleting twice succeeds",
      "steps": [
        {
          "op": "delete",
          "key": "symvault:/v|wrap-key",
          "outcome": "ok"
        },
        {
          "op": "set",
          "key": "symvault:/v|wrap-key",
          "value": "value",
          "outcome": "ok"
        },
        {
          "op": "delete",
          "key": "symvault:/v|wrap-key",
          "outcome": "ok"
        },
        {
          "op": "delete",
          "key": "symvault:/v|wrap-key",
          "outcome": "ok"
        },
        {
          "op": "get",
          "key": "symvault:/v|wrap-key",
          "outcome": "not_found"
        }
      ]
    },
    {
      "name": "accounts_are_independent",
      "description": "two accounts under one service do not collide",
      "steps": [
        {
          "op": "set",
          "key": "symvault:/v|wrap-key",
          "value": "w",
          "outcome": "ok"
        },
        {
          "op": "set",
          "key": "symvault:/v|identity",
          "value": "i",
          "outcome": "ok"
        },
        {
          "op": "get",
          "key": "symvault:/v|wrap-key",
          "outcome": "found",
          "got": "w"
        },
        {
          "op": "get",
          "key": "symvault:/v|identity",
          "outcome": "found",
          "got": "i"
        },
        {
          "op": "delete",
          "key": "symvault:/v|wrap-key",
          "outcome": "ok"
        },
        {
          "op": "get",
          "key": "symvault:/v|identity",
          "outcome": "found",
          "got": "i"
        }
      ]
    },
    {
      "name": "services_are_independent",
      "description": "the same account under two vaults does not collide",
      "steps": [
        {
          "op": "set",
          "key": "symvault:/v|wrap-key",
          "value": "a",
          "outcome": "ok"
        },
        {
          "op": "set",
          "key": "symvault:/other|wrap-key",
          "value": "b",
          "outcome": "ok"
        },
        {
          "op": "get",
          "key": "symvault:/v|wrap-key",
          "outcome": "found",
          "got": "a"
        },
        {
          "op": "get",
          "key": "symvault:/other|wrap-key",
          "outcome": "found",
          "got": "b"
        }
      ]
    },
    {
      "name": "empty_value_round_trips",
      "description": "an empty value is stored, not treated as absent",
      "steps": [
        {
          "op": "set",
          "key": "symvault:/v|wrap-key",
          "outcome": "ok"
        },
        {
          "op": "get",
          "key": "symvault:/v|wrap-key",
          "outcome": "found"
        }
      ]
    },
    {
      "name": "binary_payload_round_trips",
      "description": "the value is bytes, not text: NUL and non-ASCII survive",
      "steps": [
        {
          "op": "set",
          "key": "symvault:/v|identity",
          "value": "a\u0000b-äöü",
          "outcome": "ok"
        },
        {
          "op": "get",
          "key": "symvault:/v|identity",
          "outcome": "found",
          "got": "a\u0000b-äöü"
        }
      ]
    }
  ],
  "divergent_cases": [
    {
      "name": "session_account_discards_an_opaque_value",
      "description": "Set accepts the value; Get cannot parse it as a session and deletes it",
      "steps": [
        {
          "op": "set",
          "key": "symvault:/v|session",
          "value": "opaque-value",
          "outcome": "ok"
        },
        {
          "op": "get",
          "key": "symvault:/v|session",
          "outcome": "not_found"
        }
      ],
      "rust_outcomes": [
        "ok",
        "found"
      ]
    },
    {
      "name": "session_account_second_read_confirms_the_delete",
      "description": "the entry is gone after the failed read, not merely unreadable",
      "steps": [
        {
          "op": "set",
          "key": "symvault:/v|session",
          "value": "opaque-value",
          "outcome": "ok"
        },
        {
          "op": "get",
          "key": "symvault:/v|session",
          "outcome": "not_found"
        },
        {
          "op": "get",
          "key": "symvault:/v|session",
          "outcome": "not_found"
        }
      ],
      "rust_outcomes": [
        "ok",
        "found",
        "found"
      ]
    }
  ]
}
