  "split_cases": [
    {
      "name": "production_session",
      "description": "the shape every production call site builds",
      "key": "symvault:/home/u/.symvault|session",
      "service": "symvault:/home/u/.symvault",
      "account": "session",
      "natively_addressable": true
    },
    {
      "name": "production_identity",
      "description": "the identity account uses the same service",
      "key": "symvault:/home/u/.symvault|identity",
      "service": "symvault:/home/u/.symvault",
      "account": "identity",
      "natively_addressable": true
    },
    {
      "name": "production_wrap_key",
      "description": "and so does the wrap key",
      "key": "symvault:/home/u/.symvault|wrap-key",
      "service": "symvault:/home/u/.symvault",
      "account": "wrap-key",
      "natively_addressable": true
    },
    {
      "name": "service_contains_separator",
      "description": "a vault path may contain the separator; the LAST one splits",
      "key": "symvault:/home/a|b|session",
      "service": "symvault:/home/a|b",
      "account": "session",
      "natively_addressable": true
    },
    {
      "name": "service_contains_many_separators",
      "description": "still the last one, however many there are",
      "key": "a|b|c|d|account",
      "service": "a|b|c|d",
      "account": "account",
      "natively_addressable": true
    },
    {
      "name": "empty_service",
      "description": "a leading separator yields an empty service, not an error",
      "key": "|account",
      "service": "",
      "account": "account",
      "natively_addressable": true
    },
    {
      "name": "empty_account",
      "description": "a trailing separator yields an empty account, not an error",
      "key": "service|",
      "service": "service",
      "account": "",
      "natively_addressable": true
    },
    {
      "name": "separator_only",
      "description": "both halves empty",
      "key": "|",
      "service": "",
      "account": "",
      "natively_addressable": true
    },
    {
      "name": "no_separator",
      "description": "cannot name a native item: it would land under an empty service",
      "key": "session",
      "service": "",
      "account": "session",
      "natively_addressable": false
    },
    {
      "name": "empty_key",
      "description": "the empty key has no separator either",
      "key": "",
