+    pub(crate) fn phase_deadline(deadline: Option<std::time::Instant>) {
+        DEADLINE_TRACE.with_borrow(|trace| {
+            if let (Some(trace), Some(deadline)) = (trace, deadline) {
+                let ns = deadline.saturating_duration_since(trace.started).as_nanos();
+                trace
+                    .events
+                    .lock()
+                    .unwrap_or_else(|e| e.into_inner())
+                    .push(("absolute_deadline.target", ns));
+            }
+        });
+    }
