+    pub(crate) fn phase(name: &'static str) {
+        DEADLINE_TRACE.with_borrow(|trace| {
+            if let Some(trace) = trace {
+                let now = trace.started.elapsed().as_nanos();
+                let mut events = trace.events.lock().unwrap_or_else(|e| e.into_inner());
