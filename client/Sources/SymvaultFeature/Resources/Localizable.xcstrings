    "Symaira Vault is the native client for the self-hosted symvault runtime. Copied secrets leave the clipboard after 30 seconds.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Symaira Vault ist der native Client für die selbst gehostete symvault-Runtime. Kopierte Secrets verlassen die Zwischenablage nach 30 Sekunden."
          }
        }
      }
    },
