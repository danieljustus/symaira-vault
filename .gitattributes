AGENTS.md export-ignore
CLAUDE.md export-ignore
.opencode/ export-ignore

# Keep LF line endings for templates and golden files to avoid
# cross-platform test failures (Windows CRLF conversion).
*.tmpl text eol=lf
*.golden text eol=lf
*.go text eol=lf
# The Go module files feed the same working-tree provenance digests as the
# sources above (provenance.Digest reads the checkout, not the blob), so a
# Windows CRLF checkout makes exportgen's oracle digest disagree with the pin.
go.mod text eol=lf
go.sum text eol=lf
# The detached Go oracle programs are carried as .txt so they do not compile
# with the generator; their bytes feed a provenance digest, so a Windows CRLF
# checkout would make that digest disagree with every other platform.
*.go.txt text eol=lf
*.rs text eol=lf
Cargo.toml text eol=lf
Cargo.lock text eol=lf
rust-toolchain.toml text eol=lf
deny.toml text eol=lf
testdata/port/** text eol=lf
