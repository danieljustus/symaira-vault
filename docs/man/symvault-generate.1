.nh
.TH "SYMVAULT" "1" "Aug 2026" "Symaira Vault" "Symaira Vault Manual"

.SH NAME
symvault-generate - Generate a secure password


.SH SYNOPSIS
\fBsymvault generate [flags]\fP


.SH DESCRIPTION
Generate a secure password


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for generate

.PP
\fB-l\fP, \fB--length\fP=20
	Password length

.PP
\fB--quiet\fP[=false]
	Suppress success output when using --store

.PP
\fB--reveal\fP[=false]
	Include generated password in output when using --store

.PP
\fB--store\fP=""
	Store at path (optional)

.PP
\fB-s\fP, \fB--symbols\fP[=false]
	Include symbols


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	When to emit ANSI color: auto, always, never

.PP
\fB--json\fP[=false]
	Output format shorthand for --output json; overrides --output when both are specified

.PP
\fB--no-pipe-warning\fP[=false]
	suppress 'reading from non-TTY' warning when piping secrets

.PP
\fB--output\fP="text"
	Output format (text, json, yaml)

.PP
\fB--profile\fP=""
	use a named vault profile

.PP
\fB--theme\fP=""
	Color preset: default, highcontrast, colorblind (or SYMVAULT_THEME)

.PP
\fB--vault\fP="~/.symvault"
	path to the password vault


.SH EXAMPLE
.EX
  # Generate a 20-character password
  symvault generate --length 20

  # Include symbols
  symvault generate --length 32 --symbols

  # Generate and store
  symvault generate --store newaccount.password
.EE


.SH SEE ALSO
\fBsymvault(1)\fP, \fBsymvault-generate-manpages(1)\fP
