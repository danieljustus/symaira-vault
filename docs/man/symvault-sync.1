.nh
.TH "SYMVAULT" "1" "Aug 2026" "Symaira Vault" "Symaira Vault Manual"

.SH NAME
symvault-sync - Sync vault with remote (pull + optional push)


.SH SYNOPSIS
\fBsymvault sync [flags]\fP


.SH DESCRIPTION
Pulls changes from the remote git repository and optionally pushes local changes.


.SH OPTIONS
\fB-f\fP, \fB--force\fP[=false]
	force pull (reset local changes)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for sync

.PP
\fB-p\fP, \fB--push\fP[=false]
	also push after pull


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	When to emit ANSI color: auto, always, never

.PP
\fB--json\fP[=false]
	Output format shorthand for --output json; overrides --output when both are specified

.PP
\fB--no-pipe-warning\fP[=false]
	suppress 'reading from non-TTY' warning when piping secrets

.PP
\fB--output\fP="text"
	Output format (text, json, yaml)

.PP
\fB--profile\fP=""
	use a named vault profile

.PP
\fB--quiet\fP[=false]
	suppress non-error output

.PP
\fB--theme\fP=""
	Color preset: default, highcontrast, colorblind (or SYMVAULT_THEME)

.PP
\fB--vault\fP="~/.symvault"
	path to the password vault


.SH EXAMPLE
.EX
  # Pull only
  symvault sync

  # Pull and push
  symvault sync --push

  # Force pull (reset local changes)
  symvault sync --force
.EE


.SH SEE ALSO
\fBsymvault(1)\fP
