.nh
.TH "SYMVAULT" "1" "Sep 2026" "Symaira Vault" "Symaira Vault Manual"

.SH NAME
symvault-auth-rotate-passphrase - Change the vault master passphrase


.SH SYNOPSIS
\fBsymvault auth rotate-passphrase [flags]\fP


.SH DESCRIPTION
Change the vault's master passphrase without re-initializing the vault.
The X25519 key pair stays the same — only the passphrase protecting it is changed.
Optionally re-encrypts all entries with the new passphrase.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for rotate-passphrase

.PP
\fB--reencrypt\fP[=true]
	Re-encrypt all entries

.PP
\fB-y\fP, \fB--yes\fP[=false]
	Skip confirmation prompt


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	When to emit ANSI color: auto, always, never

.PP
\fB--json\fP[=false]
	Output format shorthand for --output json; overrides --output when both are specified

.PP
\fB--no-pipe-warning\fP[=false]
	suppress 'reading from non-TTY' warning when piping secrets

.PP
\fB--output\fP="text"
	Output format (text, json, yaml)

.PP
\fB--profile\fP=""
	use a named vault profile

.PP
\fB--quiet\fP[=false]
	suppress non-error output

.PP
\fB--theme\fP=""
	Color preset: default, highcontrast, colorblind (or SYMVAULT_THEME)

.PP
\fB--vault\fP="~/.symvault"
	path to the password vault


.SH EXAMPLE
.EX
  # Change the passphrase only
  symvault rotate-passphrase

  # Change passphrase AND re-encrypt all entries (slow but clean)
  symvault rotate-passphrase --reencrypt
.EE


.SH SEE ALSO
\fBsymvault-auth(1)\fP
