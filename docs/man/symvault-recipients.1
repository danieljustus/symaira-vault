.nh
.TH "SYMVAULT" "1" "Aug 2026" "Symaira Vault" "Symaira Vault Manual"

.SH NAME
symvault-recipients - Manage vault recipients for multi-user encryption


.SH SYNOPSIS
\fBsymvault recipients [flags]\fP


.SH DESCRIPTION
Manage recipients (public keys) that can decrypt vault entries.

.PP
Recipients are stored in recipients.txt in the vault directory.
Each line contains one public key in age format (starting with "age1").
Lines starting with # are treated as comments.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for recipients


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	When to emit ANSI color: auto, always, never

.PP
\fB--json\fP[=false]
	Output format shorthand for --output json; overrides --output when both are specified

.PP
\fB--no-pipe-warning\fP[=false]
	suppress 'reading from non-TTY' warning when piping secrets

.PP
\fB--output\fP="text"
	Output format (text, json, yaml)

.PP
\fB--profile\fP=""
	use a named vault profile

.PP
\fB--quiet\fP[=false]
	suppress non-error output

.PP
\fB--theme\fP=""
	Color preset: default, highcontrast, colorblind (or SYMVAULT_THEME)

.PP
\fB--vault\fP="~/.symvault"
	path to the password vault


.SH EXAMPLE
.EX
  symvault recipients list              # List all recipients
  symvault recipients add age1...       # Add a new recipient
  symvault recipients remove age1...    # Remove a recipient
.EE


.SH SEE ALSO
\fBsymvault(1)\fP, \fBsymvault-recipients-add(1)\fP, \fBsymvault-recipients-list(1)\fP, \fBsymvault-recipients-remove(1)\fP
