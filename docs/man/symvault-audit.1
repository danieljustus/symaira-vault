.nh
.TH "SYMVAULT" "1" "Sep 2026" "Symaira Vault" "Symaira Vault Manual"

.SH NAME
symvault-audit - View MCP audit logs


.SH SYNOPSIS
\fBsymvault audit [flags]\fP


.SH DESCRIPTION
View audit logs of MCP tool invocations.

.PP
By default shows the last 20 entries. Use --tail to change the number of entries.
Use --json for machine-readable output. Use --agent to filter by agent name.
Use --since to filter by time (e.g. "1h", "24h", "7d").


.SH OPTIONS
\fB-a\fP, \fB--agent\fP="default"
	Agent name to filter by

.PP
\fB--failed\fP[=false]
	Show only failed entries

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for audit

.PP
\fB-j\fP, \fB--json\fP[=false]
	Output as JSON (deprecated: use --output=json)

.PP
\fB-s\fP, \fB--since\fP=""
	Show entries since duration (e.g. 1h, 24h, 7d)

.PP
\fB-n\fP, \fB--tail\fP=20
	Number of entries to show


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	When to emit ANSI color: auto, always, never

.PP
\fB--no-pipe-warning\fP[=false]
	suppress 'reading from non-TTY' warning when piping secrets

.PP
\fB--output\fP="text"
	Output format (text, json, yaml)

.PP
\fB--profile\fP=""
	use a named vault profile

.PP
\fB--quiet\fP[=false]
	suppress non-error output

.PP
\fB--theme\fP=""
	Color preset: default, highcontrast, colorblind (or SYMVAULT_THEME)

.PP
\fB--vault\fP="~/.symvault"
	path to the password vault


.SH EXAMPLE
.EX
  # Last 20 audit entries
  symvault audit

  # Last 100 entries, JSON format
  symvault audit --tail 100 --output json

  # Failed invocations in the last day from a specific agent
  symvault audit --agent claude-code --since 24h --failed
.EE


.SH SEE ALSO
\fBsymvault(1)\fP, \fBsymvault-audit-export(1)\fP, \fBsymvault-audit-rotate-key(1)\fP
