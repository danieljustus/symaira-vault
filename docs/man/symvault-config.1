.nh
.TH "SYMVAULT" "1" "Sep 2026" "Symaira Vault" "Symaira Vault Manual"

.SH NAME
symvault-config - Manage Symaira Vault configuration


.SH SYNOPSIS
\fBsymvault config [flags]\fP


.SH DESCRIPTION
Manage Symaira Vault configuration including validation, profiles, and key-value editing.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for config


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	When to emit ANSI color: auto, always, never

.PP
\fB--json\fP[=false]
	Output format shorthand for --output json; overrides --output when both are specified

.PP
\fB--no-pipe-warning\fP[=false]
	suppress 'reading from non-TTY' warning when piping secrets

.PP
\fB--output\fP="text"
	Output format (text, json, yaml)

.PP
\fB--profile\fP=""
	use a named vault profile

.PP
\fB--quiet\fP[=false]
	suppress non-error output

.PP
\fB--theme\fP=""
	Color preset: default, highcontrast, colorblind (or SYMVAULT_THEME)

.PP
\fB--vault\fP="~/.symvault"
	path to the password vault


.SH EXAMPLE
.EX
  # Validate the default config file
  symvault config validate

  # Validate a specific file
  symvault config validate ~/custom-config.yaml

  # Get a config value
  symvault config get vaultDir

  # Set a config value
  symvault config set agents.claude-code.canWrite true

  # List all config
  symvault config list

  # JSON output
  symvault config get vaultDir --output json
.EE


.SH SEE ALSO
\fBsymvault(1)\fP, \fBsymvault-config-get(1)\fP, \fBsymvault-config-list(1)\fP, \fBsymvault-config-set(1)\fP, \fBsymvault-config-validate(1)\fP
