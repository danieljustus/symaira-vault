.TH "SYMVAULT" "1" "Sep 2026" "Symaira Vault" "Symaira Vault Manual"

.SH NAME
symvault-device-approval-list - List devices enrolled as approval devices


.SH SYNOPSIS
\fBsymvault device approval-list [flags]\fP


.SH DESCRIPTION
List devices that can approve or deny agent credential requests
(enrolled via 'symvault device approval-pair'). This is a different device
registry from 'symvault device list', which shows vault-content sync
devices — an approval device cannot decrypt vault entries, it can only
approve or deny agent requests.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for approval-list


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	When to emit ANSI color: auto, always, never

.PP
\fB--json\fP[=false]
	Output format shorthand for --output json; overrides --output when both are specified

.PP
\fB--no-pipe-warning\fP[=false]
	suppress 'reading from non-TTY' warning when piping secrets

.PP
\fB--output\fP="text"
	Output format (text, json, yaml)

.PP
\fB--profile\fP=""
	use a named vault profile

.PP
\fB--quiet\fP[=false]
	suppress non-error output

.PP
\fB--theme\fP=""
	Color preset: default, highcontrast, colorblind (or SYMVAULT_THEME)

.PP
\fB--vault\fP="~/.symvault"
	path to the password vault


.SH SEE ALSO
\fBsymvault-device(1)\fP
