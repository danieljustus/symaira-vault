.nh
.TH "SYMVAULT" "1" "Sep 2026" "Symaira Vault" "Symaira Vault Manual"

.SH NAME
symvault-remote-init - Initialize git remote for the vault


.SH SYNOPSIS
\fBsymvault remote init  [flags]\fP


.SH DESCRIPTION
Configure a remote git repository for vault synchronization.

.PP
The ssh-target can be in these formats:
  user@host           - bare repo at ~/symvault-remote.git on remote
  user@host:path      - bare repo at path on remote
  host                - bare repo at ~/symvault-remote.git using current user
  host:path           - bare repo at path using current user

.PP
Flags:
  --name   - Remote name (default: "origin")
  --path   - Custom bare repo path on remote (default: ~/symvault-remote.git)
  --push   - Push the vault to the remote after setup

.PP
This command also enables git.auto_push in your Symaira Vault config.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for init

.PP
\fB-n\fP, \fB--name\fP="origin"
	Remote name

.PP
\fB-p\fP, \fB--path\fP=""
	Custom bare repo path on remote (default: ~/symvault-remote.git)

.PP
\fB--push\fP[=false]
	Push vault to remote after setup


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	When to emit ANSI color: auto, always, never

.PP
\fB--json\fP[=false]
	Output format shorthand for --output json; overrides --output when both are specified

.PP
\fB--no-pipe-warning\fP[=false]
	suppress 'reading from non-TTY' warning when piping secrets

.PP
\fB--output\fP="text"
	Output format (text, json, yaml)

.PP
\fB--profile\fP=""
	use a named vault profile

.PP
\fB--quiet\fP[=false]
	suppress non-error output

.PP
\fB--theme\fP=""
	Color preset: default, highcontrast, colorblind (or SYMVAULT_THEME)

.PP
\fB--vault\fP="~/.symvault"
	path to the password vault


.SH EXAMPLE
.EX
  symvault remote init hermes@macmini
  symvault remote init dev@server:/srv/git/symvault.git --name upstream
  symvault remote init hermes@macmini --push
.EE


.SH SEE ALSO
\fBsymvault-remote(1)\fP
