.nh
.TH "SYMVAULT" "1" "Sep 2026" "Symaira Vault" "Symaira Vault Manual"

.SH NAME
symvault-agent - Manage agent profiles


.SH SYNOPSIS
\fBsymvault agent [flags]\fP


.SH DESCRIPTION
Configure AI agent profiles with scoped permissions, tokens, and MCP integration.

.PP
Use 'symvault agent install \&' to create a security profile, scoped token,
MCP configuration, and agent skill package.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for agent


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	When to emit ANSI color: auto, always, never

.PP
\fB--json\fP[=false]
	Output format shorthand for --output json; overrides --output when both are specified

.PP
\fB--no-pipe-warning\fP[=false]
	suppress 'reading from non-TTY' warning when piping secrets

.PP
\fB--output\fP="text"
	Output format (text, json, yaml)

.PP
\fB--profile\fP=""
	use a named vault profile

.PP
\fB--quiet\fP[=false]
	suppress non-error output

.PP
\fB--theme\fP=""
	Color preset: default, highcontrast, colorblind (or SYMVAULT_THEME)

.PP
\fB--vault\fP="~/.symvault"
	path to the password vault


.SH EXAMPLE
.EX
  # Install and configure an agent
  symvault agent install claude-code

  # List configured agents
  symvault agent list

  # Issue a token for an agent
  symvault agent token new claude-code
.EE


.SH SEE ALSO
\fBsymvault(1)\fP, \fBsymvault-agent-audit(1)\fP, \fBsymvault-agent-doctor(1)\fP, \fBsymvault-agent-install(1)\fP, \fBsymvault-agent-list(1)\fP, \fBsymvault-agent-profile(1)\fP, \fBsymvault-agent-skill(1)\fP, \fBsymvault-agent-token(1)\fP, \fBsymvault-agent-uninstall(1)\fP, \fBsymvault-agent-upgrade(1)\fP, \fBsymvault-agent-whoami(1)\fP
