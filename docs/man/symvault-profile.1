.nh
.TH "SYMVAULT" "1" "Aug 2026" "Symaira Vault" "Symaira Vault Manual"

.SH NAME
symvault-profile - Manage vault profiles


.SH SYNOPSIS
\fBsymvault profile [flags]\fP


.SH DESCRIPTION
Manage named vault profiles for switching between multiple vaults.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for profile


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	When to emit ANSI color: auto, always, never

.PP
\fB--no-pipe-warning\fP[=false]
	suppress 'reading from non-TTY' warning when piping secrets

.PP
\fB--output\fP="text"
	Output format (text, json, yaml)

.PP
\fB--profile\fP=""
	use a named vault profile

.PP
\fB--quiet\fP[=false]
	suppress non-error output

.PP
\fB--theme\fP=""
	Color preset: default, highcontrast, colorblind (or SYMVAULT_THEME)

.PP
\fB--vault\fP="~/.symvault"
	path to the password vault


.SH EXAMPLE
.EX
  symvault profile list
  symvault profile add work --vault ~/.symvault-work
  symvault profile use work
.EE


.SH SEE ALSO
\fBsymvault(1)\fP, \fBsymvault-profile-add(1)\fP, \fBsymvault-profile-list(1)\fP, \fBsymvault-profile-use(1)\fP
