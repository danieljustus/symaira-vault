.nh
.TH "SYMVAULT" "1" "Aug 2026" "Symaira Vault" "Symaira Vault Manual"

.SH NAME
symvault-export - Export vault entries to CSV or JSON


.SH SYNOPSIS
\fBsymvault export [flags]\fP


.SH DESCRIPTION
Exports all vault entries in CSV or JSON format for portability and backup.


.SH OPTIONS
\fB--format\fP=""
	Export format: csv or json (required)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for export

.PP
\fB--mapping\fP=""
	Column mapping (format: vault_field=output_header,...)

.PP
\fB--output\fP=""
	Output file path (default: stdout)

.PP
\fB-y\fP, \fB--yes\fP[=false]
	Skip confirmation prompt


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	When to emit ANSI color: auto, always, never

.PP
\fB--json\fP[=false]
	Output format shorthand for --output json; overrides --output when both are specified

.PP
\fB--no-pipe-warning\fP[=false]
	suppress 'reading from non-TTY' warning when piping secrets

.PP
\fB--profile\fP=""
	use a named vault profile

.PP
\fB--quiet\fP[=false]
	suppress non-error output

.PP
\fB--theme\fP=""
	Color preset: default, highcontrast, colorblind (or SYMVAULT_THEME)

.PP
\fB--vault\fP="~/.symvault"
	path to the password vault


.SH EXAMPLE
.EX
  # Export all entries as JSON
  symvault export --format json

  # Export as CSV to a file
  symvault export --format csv --output ~/vault-export.csv

  # Export with field mapping (rename columns)
  symvault export --format csv --mapping "path=title,username=user,password=secret"
.EE


.SH SEE ALSO
\fBsymvault(1)\fP
