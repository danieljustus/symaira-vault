.nh
.TH "SYMVAULT" "1" "Sep 2026" "Symaira Vault" "Symaira Vault Manual"

.SH NAME
symvault-config-set - Set a configuration value


.SH SYNOPSIS
\fBsymvault config set   [flags]\fP


.SH DESCRIPTION
Set the value of a configuration key using dotted path notation.
The value is automatically parsed as YAML to infer types: true/false for booleans,
numbers for integers, and quoted strings for text.

.PP
Examples:
  symvault config set vaultDir ~/my-vault
  symvault config set agents.claude-code.canWrite true
  symvault config set mcp.port 9090
  symvault config set clipboard.auto_clear_duration 60


.SH OPTIONS
\fB--file\fP=""
	path to config file (default: ~/.symvault/config.yaml)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for set


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	When to emit ANSI color: auto, always, never

.PP
\fB--json\fP[=false]
	Output format shorthand for --output json; overrides --output when both are specified

.PP
\fB--no-pipe-warning\fP[=false]
	suppress 'reading from non-TTY' warning when piping secrets

.PP
\fB--output\fP="text"
	Output format (text, json, yaml)

.PP
\fB--profile\fP=""
	use a named vault profile

.PP
\fB--quiet\fP[=false]
	suppress non-error output

.PP
\fB--theme\fP=""
	Color preset: default, highcontrast, colorblind (or SYMVAULT_THEME)

.PP
\fB--vault\fP="~/.symvault"
	path to the password vault


.SH SEE ALSO
\fBsymvault-config(1)\fP
