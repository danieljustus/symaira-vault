.nh
.TH "SYMVAULT" "1" "Aug 2026" "Symaira Vault" "Symaira Vault Manual"

.SH NAME
symvault-policy - Manage declarative policies


.SH SYNOPSIS
\fBsymvault policy [flags]\fP


.SH DESCRIPTION
Manage context-aware auto-approval policies for MCP tool calls.

.PP
Policies are YAML files stored in the vault's "policies" directory
(/policies). The MCP server loads policies from this same location,
so a policy applied with "policy apply" is enforced by the server.
They define rules for when tool calls should be allowed, denied,
prompted, or require biometric authentication.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for policy


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	When to emit ANSI color: auto, always, never

.PP
\fB--no-pipe-warning\fP[=false]
	suppress 'reading from non-TTY' warning when piping secrets

.PP
\fB--output\fP="text"
	Output format (text, json, yaml)

.PP
\fB--profile\fP=""
	use a named vault profile

.PP
\fB--quiet\fP[=false]
	suppress non-error output

.PP
\fB--theme\fP=""
	Color preset: default, highcontrast, colorblind (or SYMVAULT_THEME)

.PP
\fB--vault\fP="~/.symvault"
	path to the password vault


.SH EXAMPLE
.EX
  # Validate a policy file before activating it
  symvault policy validate ./my-policy.yaml

  # Apply a policy
  symvault policy apply ./my-policy.yaml

  # List active policies
  symvault policy list

  # Remove a named policy (use the file name shown by 'policy list')
  symvault policy remove dev.yaml
.EE


.SH SEE ALSO
\fBsymvault(1)\fP, \fBsymvault-policy-apply(1)\fP, \fBsymvault-policy-list(1)\fP, \fBsymvault-policy-remove(1)\fP, \fBsymvault-policy-validate(1)\fP
