.nh
.TH "SYMVAULT" "1" "Sep 2026" "Symaira Vault" "Symaira Vault Manual"

.SH NAME
symvault-recipients-add - Add a recipient


.SH SYNOPSIS
\fBsymvault recipients add  [flags]\fP


.SH DESCRIPTION
Add a new recipient (public key) to the vault.

.PP
The public key must be a valid age public key starting with "age1".
Once added, all new entries will be encrypted for this recipient.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for add

.PP
\fB--reencrypt\fP[=false]
	Re-encrypt existing entries for the new recipient


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--color\fP="auto"
	When to emit ANSI color: auto, always, never

.PP
\fB--json\fP[=false]
	Output format shorthand for --output json; overrides --output when both are specified

.PP
\fB--no-pipe-warning\fP[=false]
	suppress 'reading from non-TTY' warning when piping secrets

.PP
\fB--output\fP="text"
	Output format (text, json, yaml)

.PP
\fB--profile\fP=""
	use a named vault profile

.PP
\fB--quiet\fP[=false]
	suppress non-error output

.PP
\fB--theme\fP=""
	Color preset: default, highcontrast, colorblind (or SYMVAULT_THEME)

.PP
\fB--vault\fP="~/.symvault"
	path to the password vault


.SH EXAMPLE
.EX
  symvault recipients add age1ql3z7hjy54pw3hyww5ayyfg7zqgvc7w3j2elw8zmrj2kg5sfn9aqmcac8p
.EE


.SH SEE ALSO
\fBsymvault-recipients(1)\fP
